# ========================================================================
# DVAGO server configuration
# ========================================================================
#
# HOW TO USE:
#   1. Copy this file and rename to:   .env   (notice: no .example at end)
#   2. Uncomment ONE line (remove the # at start) for each setting you want
#   3. Replace the placeholder value with your real key
#   4. Save file, then restart the server:  Ctrl+C, then: node server.js
#
# Lines starting with #  are IGNORED  (they are comments).
# You MUST remove the leading #  for the line to take effect.
#
# ========================================================================

# ---- Admin login (optional overrides; defaults work fine) ----
# ADMIN_EMAIL=admin@dvago.com
# ADMIN_PASSWORD=change-me-in-production


# ---- Groq API ---- FREE tier at https://console.groq.com/keys ----
# Enables SARAH's dynamic follow-up questions (Llama 3.3 70B).
# Without this key, SARAH only asks the scripted questions (no follow-ups).
#
# To activate: remove the # from the next line and paste your real key:
# GROQ_API_KEY=gsk_paste_your_real_key_here
# GROQ_MODEL=llama-3.3-70b-versatile


# ---- Claude API ---- paid, enables deep AI case-study evaluation ----
# ANTHROPIC_API_KEY=sk-ant-your_key_here


# ---- SMTP ---- real email delivery (optional) ----
# Without SMTP, emails are saved to data/emails/ as JSON+HTML files you can view.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=DVAGO HR <hr@dvago.pk>
